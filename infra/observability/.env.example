NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_REGION=US
TF_VAR_new_relic_account_id=
DD_API_KEY=
DD_APP_KEY=
DD_HOST=https://api.us5.datadoghq.com/
TF_VAR_alert_email=
